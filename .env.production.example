# Copy thành .env trên máy chủ: cp .env.production.example .env  rồi điền từng dòng.

# Tên miền đã trỏ bản ghi A về IP máy chủ (không có https://, không có www)
DOMAIN=
# Email nhận thông báo từ Let's Encrypt về chứng chỉ HTTPS
ACME_EMAIL=

# Tạo bằng: openssl rand -hex 32  (giữ cố định; đổi sẽ đăng xuất mọi người và mất API key AI đã lưu)
SECRET_KEY=

POSTGRES_USER=postgres
# Tạo bằng: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=exhibition_diary_db

# Email gửi link quên mật khẩu. Gmail: bật xác minh 2 bước rồi tạo "App password" 16 ký tự.
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Với Gmail, địa chỉ gửi phải trùng SMTP_USER
EMAILS_FROM_EMAIL=
