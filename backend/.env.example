# Application Settings
PROJECT_NAME="Project Exhibition & Diary Platform API"
API_V1_STR="/api/v1"
DEBUG=True

# CORS Settings (Comma-separated list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Security & JWT
# Note: In production, generate a strong secret with: openssl rand -hex 32
SECRET_KEY="super-secret-development-key-change-in-production-exhibition-diary-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL with asyncpg driver)
# Example: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/exhibition_diary_db"

# Fallback SQLite Async (if you do not have PostgreSQL running immediately)
# DATABASE_URL="sqlite+aiosqlite:///./exhibition_diary.db"

# Initial Superuser (Admin) Seed
FIRST_SUPERUSER_EMAIL="admin@exhibition.edu.vn"
FIRST_SUPERUSER_PASSWORD="AdminPassword@2026"
FIRST_SUPERUSER_FULLNAME="Hệ thống Quản trị viên"
