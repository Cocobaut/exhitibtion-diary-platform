    }
  ],
  "item": [
    {
      "name": "[5.5] Trưng bày tác phẩm mới (POST /artworks)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Verify status is PENDING and save artworkIdRoom1\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.status).to.eql(\"PENDING\");",
              "    pm.expect(jsonData.data.room_id).to.eql(1);",
              "    if (jsonData.data && jsonData.data.id) {",
              "        pm.collectionVariables.set(\"artworkIdRoom1\", jsonData.data.id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Vết nứt của thời gian\",\n  \"author_display_name\": \"Bụi Thời Gian\",\n  \"is_anonymous\": false,\n  \"short_content\": \"Lời tự sự về những vết nứt thời gian không thể hàn gắn\",\n  \"content\": \"Có những vết nứt chẳng bao giờ liền lại được theo năm tháng, nhưng nó nhắc nhở chúng ta đã từng can đảm bước qua như thế nào.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/rooms/1/artworks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "rooms",
            "1",
            "artworks"
          ]
        }
      }
    },
    {
      "name": "[5.1] Lấy danh sách tác phẩm Gallery (GET /artworks)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify pagination and items format\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.items).to.be.an(\"array\");",
              "    pm.expect(jsonData.data.pagination).to.have.property(\"total_items\");",
              "    pm.expect(jsonData.data.pagination).to.have.property(\"total_pages\");",
              "    if (jsonData.data.items.length > 0) {",
              "        var first = jsonData.data.items[0];",
              "        pm.expect(first).to.have.property(\"reactions\");",
              "        pm.expect(first.reactions).to.have.property(\"total\");",
              "        if (!pm.collectionVariables.get(\"artworkIdRoom1\")) {",
              "            pm.collectionVariables.set(\"artworkIdRoom1\", first.id);",
              "        }",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/rooms/1/artworks?page=1&limit=12&filter=all",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "rooms",
            "1",
            "artworks"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "12"
            },
            {
              "key": "filter",
              "value": "all"
            }
          ]
        }
      }
    },
    {
