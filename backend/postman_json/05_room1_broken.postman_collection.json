    "description": "Postman Collection kiểm thử tự động Nhóm 5: Phòng 1 'Đổ vỡ' theo đặc tả plan_05_room1_broken.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
