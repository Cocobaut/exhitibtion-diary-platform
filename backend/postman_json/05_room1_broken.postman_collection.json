              "});",
              "",
              "pm.test(\"Verify reaction toggle response and summary\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.have.property(\"reactions_summary\");",
              "    pm.expect(jsonData.data.reactions_summary).to.have.property(\"SYMPATHY\");",
              "});"
