{
  "info": {
    "_postman_id": "91e6474d-0010-4000-8000-000000000010",
    "name": "10. Quản lý Nhật ký cộng đồng (/api/v1/admin/diaries)",
    "description": "Postman Collection kiểm thử tự động Nhóm 10: Quản lý và kiểm duyệt nhật ký cộng đồng theo đặc tả plan_10_admin_diaries.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "pendingDiaryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "approvedDiaryId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "[10.1] Danh sách nhật ký công khai chờ duyệt (GET /admin/diaries/pending)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify pending diaries and capture pendingDiaryId\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.pagination).to.have.property(\"total_pending\");",
              "    pm.expect(jsonData.data.items).to.be.an(\"array\");",
              "    if (jsonData.data.items.length > 0) {",
              "        var item = jsonData.data.items[0];",
              "        pm.expect(item).to.have.property(\"author\");",
              "        pm.expect(item.author).to.have.property(\"username\");",
              "        pm.expect(item.author).to.have.property(\"nickname\");",
              "        pm.collectionVariables.set(\"pendingDiaryId\", item.id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/diaries/pending?page=1&limit=15",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "diaries",
            "pending"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "15"
            }
          ]
        }
      }
    },
    {
      "name": "[10.2] Phê duyệt hiển thị lên Tab Cộng đồng (PATCH /admin/diaries/{id}/approve)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify approval result\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.eql(\"Đã phê duyệt bài nhật ký hiển thị lên Tab Cộng đồng\");",
              "    pm.expect(jsonData.data.is_public).to.eql(true);",
              "    pm.expect(jsonData.data.is_approved).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/diaries/{{pendingDiaryId}}/approve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "diaries",
            "{{pendingDiaryId}}",
            "approve"
          ]
        }
      }
    },
    {
      "name": "[10.3] Từ chối phê duyệt công khai (PATCH /admin/diaries/{id}/reject)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify rejection response\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.eql(\"Đã từ chối chia sẻ công khai. Bài viết vẫn được lưu trữ an toàn trong sổ tay riêng tư của người dùng.\");",
              "    pm.expect(jsonData.data.is_public).to.eql(false);",
              "    pm.expect(jsonData.data.is_approved).to.eql(false);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"Bài viết chứa thông tin riêng tư nhạy cảm hoặc chưa phù hợp với tính chất không gian chia sẻ cộng đồng.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/diaries/{{pendingDiaryId}}/reject",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "diaries",
            "{{pendingDiaryId}}",
            "reject"
          ]
        }
      }
    },
    {
      "name": "[10.4] Danh sách nhật ký cộng đồng đang hiển thị (GET /admin/diaries/approved)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify approved diaries and capture approvedDiaryId\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.pagination).to.have.property(\"total_items\");",
              "    pm.expect(jsonData.data.items).to.be.an(\"array\");",
              "    if (jsonData.data.items.length > 0) {",
              "        var item = jsonData.data.items[0];",
              "        pm.expect(item).to.have.property(\"reactions_total\");",
              "        pm.collectionVariables.set(\"approvedDiaryId\", item.id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/diaries/approved?q=&page=1&limit=15",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "diaries",
            "approved"
          ],
          "query": [
            {
              "key": "q",
              "value": ""
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "15"
            }
          ]
        }
      }
    },
    {
      "name": "[10.5] Gỡ bỏ bài viết khỏi Tab Cộng đồng (PATCH /admin/diaries/{id}/revoke)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify revoke response\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.eql(\"Đã gỡ bài viết khỏi Tab Cộng đồng thành công\");",
              "    pm.expect(jsonData.data.is_public).to.eql(false);",
              "    pm.expect(jsonData.data.is_approved).to.eql(false);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"admin_reason\": \"Nội dung nhận được phản ánh không phù hợp với chuẩn mực cộng đồng.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/diaries/{{approvedDiaryId}}/revoke",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "diaries",
            "{{approvedDiaryId}}",
            "revoke"
          ]
        }
      }
    },
    {
      "name": "[Quyền hạn] Test chặn người dùng không phải Admin (GET /admin/diaries/pending)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403 Forbidden\", function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "",
              "pm.test(\"Verify error_code is FORBIDDEN\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "    pm.expect(jsonData.error_code).to.eql(\"FORBIDDEN\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/diaries/pending",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "diaries",
            "pending"
          ]
        }
      }
    }
  ]
