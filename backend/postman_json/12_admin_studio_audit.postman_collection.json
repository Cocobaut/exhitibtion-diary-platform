    {
      "name": "[12.2] Lấy nhật ký quản trị toàn hệ thống (GET /admin/studio/audit-logs)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify audit logs structure\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.pagination).to.have.property(\"total_items\");",
              "    pm.expect(jsonData.data.items).to.be.an(\"array\");",
              "    if (jsonData.data.items.length > 0) {",
              "        var item = jsonData.data.items[0];",
              "        pm.expect(item).to.have.property(\"log_id\");",
              "        pm.expect(item).to.have.property(\"action_type\");",
              "        pm.expect(item).to.have.property(\"room_code\");",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/studio/audit-logs?page=1&limit=15",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
