    {
      "name": "[12.1] Xuất bản trực tiếp tác phẩm Phòng 1 (POST /admin/studio/artworks)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Verify direct published artwork\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.eql(\"Đã xuất bản tác phẩm trực tiếp lên phòng triển lãm thành công\");",
              "    pm.expect(jsonData.data.status).to.eql(\"APPROVED\");",
              "    pm.expect(jsonData.data.room_id).to.eql(1);",
              "    pm.expect(jsonData.data).to.have.property(\"media_url\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"room_id\": 1,\n  \"title\": \"Bức tường im lặng\",\n  \"author_display_name\": \"Triển Lãm Ký Ức (Ban Quản Trị)\",\n  \"short_content\": \"Tác phẩm mở màn cho không gian triển lãm Đổ Vỡ mùa thu 2026.\",\n  \"content\": \"Có những im lặng không phải vì không còn điều gì để nói...\",\n  \"media_url\": \"https://cdn.exhibition.com/artworks/2026/room-1/curator-piece-1.webp\",\n  \"is_anonymous\": false\n}"
        },
