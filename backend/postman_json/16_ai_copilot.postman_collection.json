          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.access_token) {",
                  "    pm.collectionVariables.set(\"ownerToken\", jsonData.data.access_token);",
                  "    console.log(\"Owner Token saved:\", jsonData.data.access_token.substring(0, 15) + \"...\");",
                  "}"
