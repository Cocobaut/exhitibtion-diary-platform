                  "    pm.expect(jsonData.data).to.have.property(\"is_valid\");",
                  "    pm.expect(jsonData.data).to.have.property(\"discovered_models\");",
                  "    pm.expect(jsonData.data.discovered_models).to.be.an(\"array\");",
