    {
      "name": "2. Admin - AI Copilot Soát Bài & Sinh Ảnh",
      "item": [
        {
          "name": "[2.1] Kiểm duyệt bài viết: Vi phạm nghiêm trọng (Score < 60 -> DISAPPROVE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.success).to.eql(true);",
                  "pm.expect(jsonData.data.score).to.be.below(60);",
                  "pm.expect(jsonData.data.verdict_recommendation).to.eql(\"DISAPPROVE\");",
                  "pm.expect(jsonData.data.violations).to.be.an(\"array\");",
                  "pm.expect(jsonData.data.suggested_content).to.be.a(\"string\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"art_id\": \"{{testArtId}}\",\n  \"target_room\": \"room1\",\n  \"content\": \"Hôm nay em buồn vl, chia tay thằng nyc cờ bạc nợ nần. Ai cần vay tiền liên hệ 0981234567 nha.\",\n  \"author_id\": \"u-user-violation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/ai/moderate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "ai", "moderate"]
            }
          }
        },
        {
          "name": "[2.2] Kiểm duyệt bài viết: Có thể duyệt kèm sửa đổi (Score >= 60 -> APPROVE_WITH_EDITS)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.success).to.eql(true);",
                  "pm.expect(jsonData.data.score).to.be.at.least(60);",
                  "pm.expect(jsonData.data.verdict_recommendation).to.eql(\"APPROVE_WITH_EDITS\");",
                  "pm.expect(jsonData.data.suggested_content).to.be.a(\"string\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"art_id\": \"{{testArtId}}\",\n  \"target_room\": \"room1\",\n  \"content\": \"Mùa đông năm ấy chia tay thật cay mắt, tôi nhặt từng mảnh vỡ của chiếc ly kỷ niệm và học cách tự chữa lành.\",\n  \"author_id\": \"u-user-clean\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/ai/moderate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "ai", "moderate"]
            }
          }
        },
        {
          "name": "[2.3] Kiểm duyệt bài viết: Phát hiện đăng nhầm phòng (Room Mismatch)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Verify room mismatch assessment\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.room_assessment.is_valid).to.eql(false);",
                  "    pm.expect(jsonData.data.room_assessment.suggested_room).to.eql(\"room1\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"art_id\": \"{{testArtId}}\",\n  \"target_room\": \"room2\",\n  \"content\": \"Tôi ôm mối hận thù cay đắng cuộc đời này, mọi thứ đã đổ vỡ tan nát chẳng còn gì để hy vọng.\",\n  \"author_id\": \"u-user-mismatch\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/ai/moderate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "ai", "moderate"]
            }
          }
        },
