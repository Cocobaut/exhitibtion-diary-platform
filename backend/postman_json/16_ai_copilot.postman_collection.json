    {
      "name": "1. Owner - Quản trị Cấu hình AI & Khám phá Model Động",
      "item": [
        {
          "name": "[1.1] Xem cấu hình AI hiện tại (GET /owner/ai-settings)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.success).to.eql(true);",
                  "pm.expect(jsonData.data).to.have.property(\"is_ai_enabled\");",
                  "pm.expect(jsonData.data).to.have.property(\"moderation\");",
                  "pm.expect(jsonData.data).to.have.property(\"image_generation\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
