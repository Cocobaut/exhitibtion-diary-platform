{
  "info": {
    "_postman_id": "91e6474d-0003-4000-8000-000000000003",
    "name": "03. Máy nhả thông điệp (/api/v1/capsules)",
    "description": "Postman Collection kiểm thử tự động Nhóm 3: Máy nhả thông điệp theo đặc tả plan_03_capsules.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "drawId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "[3.1] Rút thông điệp ngẫu nhiên",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Capsule drawn successfully and save drawId\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.eql(\"Rút thông điệp thành công\");",
              "    pm.expect(jsonData.data.draw_id).to.be.a(\"string\");",
              "    pm.expect(jsonData.data.capsule_id).to.be.a(\"number\");",
              "    pm.expect(jsonData.data.is_saved).to.eql(false);",
              "    pm.expect(jsonData.data.message).to.be.a(\"string\");",
              "    pm.expect(jsonData.data.category).to.be.a(\"string\");",
              "",
              "    pm.environment.set(\"drawId\", jsonData.data.draw_id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/capsules/draw",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "capsules",
            "draw"
          ]
        }
      },
      "response": []
    },
    {
      "name": "[3.1] Rút thông điệp theo thể loại",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify category is COURAGE\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.category).to.eql(\"COURAGE\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/capsules/draw?category=COURAGE",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "capsules",
            "draw"
          ],
          "query": [
            {
              "key": "category",
              "value": "COURAGE"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "[3.2] Lưu thông điệp vào sổ tay",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Draw is marked as saved\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.eql(\"Đã lưu thông điệp vào sổ tay cá nhân\");",
              "    pm.expect(jsonData.data.is_saved).to.eql(true);",
              "    pm.expect(jsonData.data.updated_at).to.be.a(\"string\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_saved\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/capsules/draws/{{drawId}}/save",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "capsules",
            "draws",
            "{{drawId}}",
            "save"
          ]
        }
      },
      "response": []
    },
    {
      "name": "[3.3] Lấy danh sách thông điệp đã lưu",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has items array and pagination\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.items).to.be.an(\"array\");",
              "    pm.expect(jsonData.data.pagination).to.be.an(\"object\");",
              "    pm.expect(jsonData.data.pagination.page).to.eql(1);",
              "    pm.expect(jsonData.data.pagination.limit).to.eql(10);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/capsules/saved?page=1&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "capsules",
            "saved"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "[3.4] Bỏ lưu thông điệp khỏi sổ tay",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Confirmation message for removing from saved\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.eql(\"Đã bỏ lưu thông điệp khỏi sổ tay\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/capsules/saved/{{drawId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "capsules",
            "saved",
            "{{drawId}}"
          ]
        }
      },
      "response": []
    }
  ]
}
