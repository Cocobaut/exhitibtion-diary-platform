    {
      "name": "[6.3] Thả lồng đèn công khai PUBLIC (POST /artworks)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Verify PUBLIC lantern is PENDING and save lanternId\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.status).to.eql(\"PENDING\");",
              "    pm.expect(jsonData.data.visibility).to.eql(\"PUBLIC\");",
              "    pm.expect(jsonData.data.room_id).to.eql(2);",
              "    pm.expect(jsonData.data).to.have.property(\"content\");",
              "    pm.expect(jsonData.data).to.have.property(\"short_content\");",
              "    if (jsonData.data && jsonData.data.id) {",
              "        pm.collectionVariables.set(\"lanternId\", jsonData.data.id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"original_language\": \"vi\",\n  \"title\": \"Lời nhắn gửi tới năm 2030\",\n  \"is_anonymous\": false,\n  \"short_content\": \"Lời chúc gửi tương lai của bản thân và mọi người\",\n  \"content\": \"Hy vọng vào năm 2030, chúng ta đều đã trở thành phiên bản mạnh mẽ, hạnh phúc và bình yên hơn hôm nay rất nhiều.\",\n  \"target_date\": \"2030-01-01T00:00:00Z\",\n  \"visibility\": \"PUBLIC\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/rooms/2/artworks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "rooms",
            "2",
            "artworks"
          ]
        }
      }
