    {
      "name": "[8.3] Viết nhật ký riêng tư (POST /diaries)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Verify is_approved=true and save diaryIdMe\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.is_public).to.eql(false);",
              "    pm.expect(jsonData.data.is_approved).to.eql(true);",
              "    if (jsonData.data && jsonData.data.id) {",
              "        pm.collectionVariables.set(\"diaryIdMe\", jsonData.data.id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"entry_date\": \"2026-10-24\",\n  \"title\": \"Một buổi chiều tĩnh lặng bên tách trà\",\n  \"mood\": \"calm\",\n  \"content\": \"Hôm nay công việc tạm gác lại một bên, mình ngồi ngắm mưa rơi ngoài hiên bên tách trà ấm.\",\n  \"media_urls\": [\"https://cdn.exhibition.com/diaries/tea-cup.webp\"],\n  \"is_public\": false,\n  \"is_encrypted\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/diaries",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "diaries"
          ]
        }
