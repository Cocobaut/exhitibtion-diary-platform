              "        var first = jsonData.data.items[0];",
              "        pm.expect(first).to.have.property(\"author\");",
              "        pm.expect(first).to.have.property(\"reactions\");",
              "        pm.collectionVariables.set(\"diaryIdCommunity\", first.id);",
