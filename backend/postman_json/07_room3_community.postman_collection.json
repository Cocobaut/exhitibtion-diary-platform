          "raw": "{\n  \"title\": \"Thông điệp sai màu\",\n  \"tag_category\": \"HEALING\",\n  \"color_code\": \"#FFD700\",\n  \"short_content\": \"Tóm tắt sai màu sắc\",\n  \"content\": \"Nội dung có mã màu không khớp với danh mục quy chuẩn\"\n}"
        },
