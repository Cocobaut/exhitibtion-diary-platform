              "        var item = jsonData.data.items[0];",
              "        pm.expect(item).to.have.property(\"energy_count\");",
              "        pm.expect(item).to.have.property(\"content\");",
              "        pm.expect(item).to.have.property(\"short_content\");",
              "    }",
              "});"
            ],
