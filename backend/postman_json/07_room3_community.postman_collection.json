        "body": {
          "mode": "raw",
          "raw": "{\n  \"original_language\": \"vi\",\n  \"title\": \"Mọi giông bão rồi sẽ tan\",\n  \"tag_category\": \"HEALING\",\n  \"color_code\": \"#98FB98\",\n  \"short_content\": \"Một chiếc ôm dịu dàng gửi tới bạn hôm nay.\",\n  \"content\": \"Gửi người đang đọc dòng này, dù hôm nay bạn có gặp khó khăn gì, hãy nhớ rằng bạn luôn mạnh mẽ hơn những gì bạn nghĩ.\"\n}"
        },
