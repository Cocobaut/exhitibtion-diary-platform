{
  "info": {
    "_postman_id": "91e6474d-0007-4000-8000-000000000007",
    "name": "07. Phòng 3 - Cây thông điệp (/api/v1/rooms/3)",
    "description": "Postman Collection kiểm thử tự động Nhóm 7: Phòng 3 'Cây thông điệp' theo đặc tả plan_07_room3_community.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "ribbonId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "[7.1] Lấy danh sách dải thông điệp trên cây (GET /artworks)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify color_legend and ribbons list\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.color_legend).to.be.an(\"array\");",
              "    pm.expect(jsonData.data.items).to.be.an(\"array\");",
              "    pm.expect(jsonData.data).to.have.property(\"total_ribbons\");",
              "    if (jsonData.data.items.length > 0) {",
              "        var item = jsonData.data.items[0];",
              "        pm.expect(item).to.have.property(\"reactions\");",
              "        pm.expect(item.reactions).to.have.property(\"ENERGY\");",
              "        pm.expect(item.reactions).to.have.property(\"HEART\");",
              "        pm.collectionVariables.set(\"ribbonId\", item.id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/rooms/3/artworks?filter=all&limit=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "rooms",
            "3",
            "artworks"
          ],
          "query": [
            {
              "key": "filter",
              "value": "all"
            },
            {
              "key": "limit",
              "value": "50"
            },
            {
              "key": "title",
              "value": "",
              "disabled": true
            },
            {
              "key": "author_display_name",
              "value": "",
              "disabled": true
            }
          ]
        }
      }
    },
    {
      "name": "[7.1] Lọc dải thông điệp theo thể loại và màu sắc (GET /artworks)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify filtered ribbons match category\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    jsonData.data.items.forEach(function (it) {",
              "        pm.expect(it.tag_category).to.eql(\"HEALING\");",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/rooms/3/artworks?category=HEALING&color_code=%2398FB98",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "rooms",
            "3",
            "artworks"
          ],
          "query": [
            {
              "key": "category",
              "value": "HEALING"
            },
            {
              "key": "color_code",
              "value": "%2398FB98"
            }
          ]
        }
      }
    },
