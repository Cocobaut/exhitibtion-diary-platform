            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/owner/users/{{targetUserId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "owner",
            "users",
            "{{targetUserId}}"
          ]
        }
      }
    },
    {
      "name": "[13.6] Xem thống kê phân bổ toàn hệ thống (GET /owner/system-stats)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify system statistics payload\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.have.property(\"users_summary\");",
              "    pm.expect(jsonData.data).to.have.property(\"exhibition_summary\");",
              "    pm.expect(jsonData.data).to.have.property(\"diaries_summary\");",
              "    pm.expect(jsonData.data).to.have.property(\"capsules_summary\");",
              "    ",
              "    pm.expect(jsonData.data.users_summary).to.have.property(\"total_users\");",
              "    pm.expect(jsonData.data.users_summary).to.have.property(\"by_role\");",
              "    pm.expect(jsonData.data.exhibition_summary).to.have.property(\"total_artworks\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ownerToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/owner/system-stats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "owner",
            "system-stats"
          ]
        }
      }
    },
    {
      "name": "[Guardrails] Chủ sở hữu không thể tự xóa tài khoản của chính mình (400 INVALID_ACTION)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Verify self-deletion protection error\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "    pm.expect(jsonData.error_code).to.eql(\"INVALID_ACTION\");",
              "    pm.expect(jsonData.message).to.eql(\"Chủ sở hữu không thể tự thao tác trên tài khoản của chính mình\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ownerToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/owner/users/{{ownerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "owner",
            "users",
            "{{ownerId}}"
          ]
        }
      }
    },
    {
      "name": "[Quyền hạn] Chặn Admin và User thường truy cập vào /owner (403 FORBIDDEN)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403 Forbidden\", function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "",
              "pm.test(\"Verify forbidden error code & message\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "    pm.expect(jsonData.error_code).to.eql(\"FORBIDDEN\");",
              "    pm.expect(jsonData.message).to.eql(\"Yêu cầu quyền Chủ sở hữu (Owner)\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
