{
  "info": {
    "_postman_id": "91e6474d-0013-4000-8000-000000000013",
    "name": "13. Owner Master Management (/api/v1/owner)",
    "description": "Postman Collection kiểm thử tự động Nhóm 13: Quyền quản trị tối cao (Owner Master) theo đặc tả plan_13_owner.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "ownerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "targetUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "ownerId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "[13.1] Tra cứu danh sách người dùng toàn hệ thống (GET /owner/users)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify list users response structure\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.have.property(\"items\");",
              "    pm.expect(jsonData.data).to.have.property(\"pagination\");",
              "    pm.expect(jsonData.data.items).to.be.an(\"array\");",
              "    ",
              "    if (jsonData.data.items.length > 0) {",
              "        var firstUser = jsonData.data.items[0];",
              "        pm.expect(firstUser).to.have.property(\"id\");",
              "        pm.expect(firstUser).to.have.property(\"username\");",
              "        pm.expect(firstUser).to.have.property(\"role\");",
              "        pm.expect(firstUser).to.have.property(\"is_active\");",
              "        pm.collectionVariables.set(\"targetUserId\", firstUser.id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ownerToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/owner/users?page=1&limit=20&search=",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "owner",
            "users"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "search",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "name": "[13.2] Xem chi tiết hồ sơ & thống kê người dùng (GET /owner/users/:user_id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify user profile and activity stats\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.have.property(\"id\");",
              "    pm.expect(jsonData.data).to.have.property(\"username\");",
              "    pm.expect(jsonData.data).to.have.property(\"role\");",
              "    pm.expect(jsonData.data).to.have.property(\"activity_stats\");",
              "    pm.expect(jsonData.data.activity_stats).to.have.property(\"artworks_count\");",
              "    pm.expect(jsonData.data.activity_stats).to.have.property(\"diaries_count\");",
              "    pm.expect(jsonData.data.activity_stats).to.have.property(\"capsules_drawn\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ownerToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/owner/users/{{targetUserId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "owner",
            "users",
            "{{targetUserId}}"
          ]
        }
      }
    },
    {
      "name": "[13.3] Khóa tài khoản người dùng hoặc Admin (PATCH /owner/users/:user_id/status)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify account deactivated\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.eql(\"Cập nhật trạng thái tài khoản thành công\");",
              "    pm.expect(jsonData.data.is_active).to.eql(false);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ownerToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_active\": false,\n  \"reason\": \"Tạm khóa để kiểm tra dấu hiệu vi phạm điều khoản\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/owner/users/{{targetUserId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "owner",
            "users",
            "{{targetUserId}}",
            "status"
          ]
        }
      }
    },
    {
      "name": "[13.3] Mở khóa / Kích hoạt lại tài khoản (PATCH /owner/users/:user_id/status)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify account reactivated\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.is_active).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ownerToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_active\": true,\n  \"reason\": \"Kích hoạt lại sau khi hoàn tất xác minh an toàn\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/owner/users/{{targetUserId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "owner",
            "users",
            "{{targetUserId}}",
            "status"
          ]
        }
      }
    },
    {
      "name": "[13.4] Cập nhật vai trò người dùng (USER <-> ADMIN) (PATCH /owner/users/:user_id/role)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify role change\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.eql(\"Cập nhật vai trò người dùng thành công\");",
              "    pm.expect(jsonData.data).to.have.property(\"old_role\");",
              "    pm.expect(jsonData.data.new_role).to.eql(\"ADMIN\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ownerToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role\": \"ADMIN\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/owner/users/{{targetUserId}}/role",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "owner",
            "users",
            "{{targetUserId}}",
            "role"
          ]
        }
      }
    },
    {
      "name": "[13.5] Xóa vĩnh viễn tài khoản người dùng (DELETE /owner/users/:user_id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify permanent deletion\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.eql(\"Đã xóa vĩnh viễn tài khoản người dùng khỏi hệ thống\");",
              "    pm.expect(jsonData.data).to.have.property(\"deleted_at\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
