          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/notebook?source=lantern",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "notebook"
          ],
          "query": [
            {
              "key": "source",
              "value": "lantern"
            }
          ]
        }
      }
