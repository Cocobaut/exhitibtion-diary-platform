{
  "info": {
    "_postman_id": "91e6474d-0014-4000-8000-000000000014",
    "name": "14. Sổ tay Ký ức Hợp nhất (/api/v1/notebook)",
    "description": "Postman Collection kiểm thử tự động Nhóm 14: Sổ tay Ký ức Hợp nhất theo đặc tả plan_14_notebook.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "[14.1] Lấy toàn bộ Sổ tay Ký ức hợp nhất",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Unified notebook structure is valid\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.have.property(\"items\");",
              "    pm.expect(jsonData.data.items).to.be.an(\"array\");",
              "    pm.expect(jsonData.data).to.have.property(\"pagination\");",
              "    pm.expect(jsonData.data.pagination).to.have.property(\"counts\");",
              "    pm.expect(jsonData.data.pagination.counts).to.have.property(\"all\");",
              "    pm.expect(jsonData.data.pagination.counts).to.have.property(\"mailbox\");",
              "    pm.expect(jsonData.data.pagination.counts).to.have.property(\"lantern\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/notebook",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "notebook"
          ]
        }
      }
    },
    {
      "name": "[14.1] Lọc sổ tay theo nguồn Hòm thư",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"All items are from mailbox source\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    jsonData.data.items.forEach(function(item) {",
              "        pm.expect(item.source).to.eql(\"mailbox\");",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/notebook?source=mailbox",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "notebook"
          ],
          "query": [
            {
              "key": "source",
              "value": "mailbox"
            }
          ]
        }
      }
    },
