    {
      "name": "[9.1.1] Lấy danh sách tác phẩm chờ duyệt Phòng 1 (GET /artworks/pending)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify pending list structure and capture pendingArtworkId\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.room_id).to.eql(1);",
              "    pm.expect(jsonData.data.room_code).to.eql(\"BROKEN\");",
              "    pm.expect(jsonData.data.pagination).to.have.property(\"total_pending\");",
              "    pm.expect(jsonData.data.items).to.be.an(\"array\");",
              "    if (jsonData.data.items.length > 0) {",
              "        var item = jsonData.data.items[0];",
              "        pm.expect(item).to.have.property(\"author\");",
              "        pm.expect(item.author).to.have.property(\"username\");",
              "        pm.expect(item.author).to.have.property(\"email\");",
              "        pm.collectionVariables.set(\"pendingArtworkId\", item.id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/rooms/1/artworks/pending?page=1&limit=15&sort=oldest",
          "host": [
            "{{baseUrl}}"
          ],
