    {
      "name": "[9.1.3] Phê duyệt tác phẩm Phòng 1 (POST /artworks/{id}/approve)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify approval result\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.eql(\"Phê duyệt tác phẩm thành công và đã xuất bản lên triển lãm\");",
              "    pm.expect(jsonData.data.status).to.eql(\"APPROVED\");",
              "    pm.expect(jsonData.data).to.have.property(\"reviewed_by\");",
              "    pm.expect(jsonData.data).to.have.property(\"reviewed_at\");",
              "    pm.expect(jsonData.data.notification_sent).to.eql(true);",
              "    pm.collectionVariables.set(\"approvedArtworkId\", jsonData.data.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
