{
  "info": {
    "_postman_id": "91e6474d-0001-4000-8000-000000000001",
    "name": "01. Xác thực & Khôi phục mật khẩu (/api/v1/auth)",
    "description": "Postman Collection kiểm thử tự động Nhóm 1: Xác thực & Khôi phục mật khẩu theo đặc tả plan_01_auth.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "[1.1] Đăng ký tài khoản mới",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has success=true, message and body containing user info with role USER\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.eql(\"Tài khoản tạo thành công\");",
              "    pm.expect(jsonData.body).to.be.an(\"object\");",
              "    pm.expect(jsonData.body.role).to.eql(\"USER\");",
              "    pm.expect(jsonData.body.username).to.eql(\"hoanghon_01\");",
              "    pm.expect(jsonData.body.email).to.eql(\"hoanghon@example.com\");",
              "    pm.expect(jsonData.body.id).to.be.a(\"string\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"hoanghon_01\",\n  \"email\": \"hoanghon@example.com\",\n  \"password\": \"StrongPassword123@\",\n  \"nickname\": \"Người Lữ Khách\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "[1.1-Lỗi] Đăng ký trùng username/email",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 409 Conflict\", function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "",
              "pm.test(\"Error code is USERNAME_TAKEN or EMAIL_TAKEN\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "    pm.expect([\"USERNAME_TAKEN\", \"EMAIL_TAKEN\"]).to.include(jsonData.error_code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"HOANGHON_01\",\n  \"email\": \"hoanghon@example.com\",\n  \"password\": \"StrongPassword123@\",\n  \"nickname\": \"Người Lữ Khách\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "[1.2] Đăng nhập tài khoản USER",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Extract accessToken and verify body structure\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.eql(\"Đăng nhập thành công\");",
              "    pm.expect(jsonData.body.token_type).to.eql(\"Bearer\");",
              "    pm.expect(jsonData.body.expires_in).to.eql(86400);",
              "    pm.expect(jsonData.body.access_token).to.be.a(\"string\");",
              "    pm.expect(jsonData.body.user.role).to.eql(\"USER\");",
              "",
              "    pm.environment.set(\"accessToken\", jsonData.body.access_token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"account\": \"hoanghon_01\",\n  \"password\": \"StrongPassword123@\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "[1.2] Đăng nhập tài khoản ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify Admin greeting and save adminToken\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.eql(\"Đăng nhập quyền quản trị viên thành công\");",
              "    pm.expect(jsonData.body.user.role).to.eql(\"ADMIN\");",
              "    pm.expect(jsonData.body.access_token).to.be.a(\"string\");",
              "",
              "    pm.environment.set(\"adminToken\", jsonData.body.access_token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"account\": \"admin@exhibition.edu.vn\",\n  \"password\": \"AdminPassword@2026\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "[1.2] Đăng nhập tài khoản OWNER",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify Owner greeting and save ownerToken\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.eql(\"Đăng nhập quyền chủ sở hữu thành công\");",
              "    pm.expect(jsonData.body.user.role).to.eql(\"OWNER\");",
              "    pm.expect(jsonData.body.access_token).to.be.a(\"string\");",
              "",
              "    pm.environment.set(\"ownerToken\", jsonData.body.access_token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"account\": \"owner@exhibition.edu.vn\",\n  \"password\": \"AdminPassword@2026\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "[1.2-Lỗi] Đăng nhập sai mật khẩu",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test(\"Error code is INVALID_CREDENTIALS\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "    pm.expect(jsonData.error_code).to.eql(\"INVALID_CREDENTIALS\");",
              "    pm.expect(jsonData.message).to.eql(\"Tài khoản hoặc mật khẩu không chính xác\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"account\": \"hoanghon_01\",\n  \"password\": \"WrongPassword123@\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "[1.3] Đổi mật khẩu trực tiếp",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Returns success and confirmation message\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.include(\"Đổi mật khẩu thành công\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"hoanghon_01\",\n  \"email\": \"hoanghon@example.com\",\n  \"new_password\": \"NewStrongPassword123@\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/change-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "change-password"
          ]
        }
      },
      "response": []
    },
    {
      "name": "[1.3-Lỗi] Đổi mật khẩu sai thông tin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Error code is INVALID_CREDENTIALS\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "    pm.expect(jsonData.error_code).to.eql(\"INVALID_CREDENTIALS\");",
              "    pm.expect(jsonData.message).to.eql(\"Tài khoản hoặc email không chính xác\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"hoanghon_01\",\n  \"email\": \"wrong_mail@example.com\",\n  \"new_password\": \"NewStrongPassword123@\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/change-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "change-password"
          ]
        }
      },
      "response": []
    },
    {
      "name": "[1.4] Đăng xuất",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Message is Đăng xuất thành công\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.eql(\"Đăng xuất thành công\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "logout"
          ]
        }
      },
      "response": []
    }
  ]
}
